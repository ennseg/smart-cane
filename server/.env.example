# Скопируйте этот файл в .env и заполните. Файл .env в git не попадает.

# --- Telegram ---------------------------------------------------------------
# Токен бота от @BotFather. Не нужен, если DRY_RUN=true.
BOT_TOKEN=
# true — не обращаться к Telegram: все сообщения бота пишутся в лог.
DRY_RUN=true
# Отладочный эндпоинт /dev/bot («написать боту» без Telegram).
# Пусто = включён только в режиме DRY_RUN.
DEV_ENDPOINTS=

# --- Сервер и база данных ---------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/cane.db
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Приём данных от устройства ---------------------------------------------
# Требовать подпись HMAC-SHA256 в заголовке X-Signature.
HMAC_REQUIRED=true
# Период передачи для новых устройств, с (уходит устройству в cfg.period_s).
DEFAULT_PERIOD_S=30
# Максимальный размер одного пакета, байт.
MAX_BODY_BYTES=4096
# Максимум пакетов в /api/v1/telemetry/batch.
BATCH_MAX_PACKETS=50

# --- Фоновые проверки -------------------------------------------------------
# «Устройство молчит», если нет пакетов дольше SILENCE_PERIODS × period_s.
SILENCE_PERIODS=3
# Как часто запускать фоновую проверку, с.
MONITOR_INTERVAL_S=15
# Как часто проверять очередь исходящих сообщений, с.
OUTBOX_POLL_S=2
# Сколько раз пытаться доставить сообщение в Telegram.
OUTBOX_MAX_ATTEMPTS=8
# Сколько ждать ответа устройства на /where (команда locate_now), с.
LOCATE_TIMEOUT_S=300

# --- SOS -------------------------------------------------------------------
# Сколько минут после SOS показывать живую геопозицию.
SOS_LIVE_MIN=10
# Через сколько секунд напоминать о непринятой тревоге и сколько раз.
SOS_REMIND_S=120
SOS_REMIND_MAX=3

# --- Антифлуд и накопленные события ----------------------------------------
# Накопленные (buffered) события старше этого возраста не рассылаются
# (кроме sos и batt_crit), только сохраняются, мин.
BUFFERED_ALERT_MAX_AGE_MIN=30
# Минимальный интервал между одинаковыми уведомлениями, мин.
COOLDOWN_STILL_MIN=10
COOLDOWN_BATT_LOW_MIN=360
COOLDOWN_BATT_CRIT_MIN=60
COOLDOWN_GPS_MIN=10
# Сколько минут писать в тревоге «неподвижность», если устройство не прислало still_min.
STILL_DEFAULT_MIN=10

# --- Привязка ---------------------------------------------------------------
# После стольких неверных кодов подряд /bind блокируется на BIND_BLOCK_MIN минут.
BIND_MAX_FAILURES=5
BIND_BLOCK_MIN=60
# Срок действия кода из /invite, ч.
INVITE_TTL_H=24
# Сколько точек показывает /history.
HISTORY_LIMIT=10

# --- Отображение ------------------------------------------------------------
DISPLAY_TZ=Europe/Moscow
MAP_URL_TEMPLATE=https://yandex.ru/maps/?pt={lon},{lat}&z=17&l=map
